---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { PAPERS } from "@consts";

const papers = (await getCollection("papers")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<PageLayout title={PAPERS.TITLE} description={PAPERS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">Papers</div>
      <ul class="flex flex-col gap-6">
        {papers.map((p) => (
          <li class="animate">
            <div class="font-semibold text-black dark:text-white">{p.data.title}</div>
            <div class="text-sm opacity-75">
              {p.data.authors}. {p.data.venue}, {p.data.date.getFullYear()}.
            </div>
            <div class="text-sm flex gap-2">
              {p.data.pdfUrl && <Link href={p.data.pdfUrl} external>pdf</Link>}
              {p.data.externalUrl && <Link href={p.data.externalUrl} external>link</Link>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</PageLayout>
